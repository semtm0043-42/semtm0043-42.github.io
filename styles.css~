@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
:root {
  --ink: #18201e;
  --muted: #68736d;
  --line: #dbe2dd;
  --paper: #f7f9f6;
  --panel: #fff;
  --green: #17694e;
  --mint: #e0f2e8;
  --orange: #dc7535;
  --purple: #7052ac;
  --lavender: #eee9fa;
  --yellow: #f5efcf;
}
* {
  box-sizing: border-box;
}
html {
  scroll-behavior: smooth;
}
body {
  margin: 0;
  color: var(--ink);
  background: var(--paper);
  font-family: 'DM Sans', sans-serif;
}
button, textarea {
  font: inherit;
}
button {
  cursor: pointer;
}
.site-shell {
  display: flex;
  min-height: 100vh;
}
.sidebar {
  width: 238px;
  flex: 0 0 238px;
  background: #edf2ee;
  border-right: 1px solid var(--line);
  padding: 24px 17px 20px;
  display: flex;
  flex-direction: column;
}
.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 9px 28px;
  color: var(--ink);
  text-decoration: none;
}
.brand-mark {
  display: grid;
  place-items: center;
  width: 35px;
  height: 35px;
  border-radius: 9px;
  background: var(--green);
  color: #fff;
  font: bold 12px 'DM Mono';
}
.brand strong, .brand small, .sidebar-footer strong, .sidebar-footer small {
  display: block;
}
.brand strong {
  font: 600 15px 'Space Grotesk';
}
.brand small, .sidebar-footer small {
  color: var(--muted);
  font-size: 11px;
  margin-top: 2px;
}
.course-status {
  margin: 0 8px 29px;
  padding: 9px 10px;
  border: 1px solid #d3ddd5;
  border-radius: 6px;
  color: var(--muted);
  font: 9px 'DM Mono';
  text-transform: uppercase;
}
.status-dot, .save-dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  margin-right: 6px;
  border-radius: 50%;
  background: #36a974;
}
.nav-label, .section-kicker, .eyebrow {
  color: var(--muted);
  font: 10px 'DM Mono';
  text-transform: uppercase;
  letter-spacing: 1px;
}
.nav-label {
  margin: 0 10px 9px;
}
.nav-reference-label {
  margin-top: 22px;
}
.nav-item {
  display: flex;
  align-items: center;
  gap: 11px;
  margin: 2px 0;
  padding: 9px 10px;
  border-radius: 6px;
  color: #5b6560;
  text-decoration: none;
  font-size: 12px;
}
.nav-item span:first-child {
  flex: 0 0 32px;
  color: #929c96;
  font: 10px 'DM Mono';
}
.nav-item.active {
  color: var(--green);
  background: #fff;
  font-weight: 600;
  box-shadow: 0 1px 1px #dce4de;
}
.nav-tree-row {
  display: flex;
  align-items: center;
}
.nav-tree-row .nav-item {
  flex: 1;
}
.nav-tree-toggle {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  margin-right: 5px;
  border: 1px solid var(--line);
  border-radius: 5px;
  color: var(--green);
  background: #fff;
  font-size: 17px;
  line-height: 1;
}
.nav-tree-toggle:hover,
.nav-tree-toggle:focus-visible {
  border-color: #a8c7b5;
  background: var(--mint);
  outline: none;
}
.nav-tree-children {
  margin: 0 0 4px 20px;
  padding-left: 8px;
  border-left: 1px solid #cdd9d1;
}
.nav-item.nav-tree-child {
  padding-top: 7px;
  padding-bottom: 7px;
  font-size: 13px;
}
.nav-item.nav-tree-child span:first-child {
  flex-basis: 25px;
  font-size: 10px;
}
.sidebar-footer {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: auto;
  padding: 17px 8px 0;
  border-top: 1px solid var(--line);
  font-size: 12px;
}
.avatar {
  display: grid;
  place-items: center;
  width: 29px;
  height: 29px;
  border-radius: 50%;
  background: #e6bd9e;
  font-size: 11px;
}
.main-content {
  width: 100%;
  max-width: 1160px;
  margin: auto;
  padding: 0 54px 38px;
}
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 74px;
  border-bottom: 1px solid var(--line);
}
.breadcrumb {
  color: #9ca6a0;
  font-size: 11px;
}
.breadcrumb b {
  margin: 0 9px;
  color: #c0c9c3;
}
.breadcrumb strong {
  color: var(--ink);
}
.save-state {
  color: #89938d;
  font: 10px 'DM Mono';
}
.intro {
  padding: 56px 0 42px;
  max-width: 770px;
}
.course-introduction-column {
  max-width: 770px;
}
.eyebrow {
  display: flex;
  align-items: center;
  gap: 9px;
  color: var(--green);
}
.eyebrow-line {
  width: 27px;
  height: 1px;
  background: var(--orange);
}
.intro h1 {
  margin: 17px 0 17px;
  font: 700 clamp(40px, 5vw, 65px)/.99 'Space Grotesk';
  letter-spacing: -3px;
}
.intro h1 em {
  color: var(--green);
  font-style: normal;
}
.lead {
  max-width: 630px;
  margin: 0;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.6;
}
.principles {
  display: flex;
  gap: 31px;
  margin-top: 35px;
}
.principles div {
  display: grid;
  grid-template-columns: 25px 1fr;
  column-gap: 8px;
  max-width: 180px;
}
.principles span {
  grid-row: span 2;
  color: var(--orange);
  font: 11px 'DM Mono';
}
.principles strong {
  font-size: 11px;
}
.principles small {
  color: var(--muted);
  font-size: 10px;
  line-height: 1.35;
  margin-top: 4px;
}
.orientation-card {
  display: flex;
  align-items: center;
  gap: 17px;
  padding: 18px 21px;
  border: 1px solid #cfe0d4;
  border-radius: 8px;
  background: var(--mint);
}
.reference-callout {
  display: flex;
  align-items: center;
  gap: 17px;
  margin-top: 30px;
  padding: 18px 21px;
  border: 1px solid #d9d2eb;
  border-radius: 8px;
  background: #f6f3fc;
}
.reference-callout h2 {
  margin: 6px 0 4px;
  font: 600 19px 'Space Grotesk';
}
.reference-callout p {
  max-width: 650px;
  margin: 0;
  color: #625a72;
  font-size: 11px;
  line-height: 1.5;
}
.reference-callout-link {
  margin-left: auto;
  color: #6b4d96;
  font: 10px 'DM Mono';
  text-decoration: none;
  white-space: nowrap;
}

@media (max-width: 650px) {
  .reference-callout {
    display: block;
  }
  .reference-callout .orientation-icon {
    margin-bottom: 12px;
  }
  .reference-callout-link {
    display: block;
    margin: 14px 0 0;
  }
}
.orientation-icon {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: #fff;
  color: var(--green);
  font-size: 20px;
}
.orientation-card h2 {
  margin: 6px 0 4px;
  font: 600 19px 'Space Grotesk';
}
.orientation-card p {
  max-width: 650px;
  margin: 0;
  color: #5a6d62;
  font-size: 11px;
  line-height: 1.5;
}
.orientation-key {
  margin-left: auto;
  min-width: 130px;
  color: #5f7065;
  font: 10px 'DM Mono';
  line-height: 1.8;
}
.key-nonai {
  color: var(--orange);
}
.key-ai {
  color: var(--purple);
}
.model-map {
  display: flex;
  align-items: center;
  gap: 25px;
  padding: 36px 0 37px;
}
.model-map h2 {
  margin: 6px 0 0;
  font: 600 19px 'Space Grotesk';
}
.signal-path {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;
  flex: 1;
  padding: 12px 14px;
  border-radius: 6px;
  background: var(--ink);
  color: #fff;
  font: 10px 'DM Mono';
}
.signal-path span:not(.overlay-note) {
  padding: 5px 7px;
  border-radius: 3px;
  background: #303b36;
}
.signal-path b {
  color: #8fa69a;
  font-weight: 400;
}
.overlay-note {
  width: 100%;
  color: #a7bbb0;
  font-size: 9px;
  margin-top: 2px;
}
.sequence-heading {
  display: flex;
  align-items: end;
  gap: 13px;
  padding: 9px 0 20px;
  border-bottom: 1px solid var(--line);
}
.section-number {
  color: var(--orange);
  font: 11px 'DM Mono';
}
.sequence-heading h2 {
  margin: 6px 0 0;
  font: 600 25px 'Space Grotesk';
}
.sequence-heading p {
  max-width: 350px;
  margin: 0 0 2px auto;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.45;
}
.exercise-sequence {
  display: grid;
  gap: 15px;
  padding-top: 15px;
}
.exercise-card {
  display: grid;
  grid-template-columns: 52px 1fr;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  scroll-margin-top: 20px;
}
.exercise-index {
  display: grid;
  place-items: start center;
  padding-top: 22px;
  color: var(--orange);
  font: 12px 'DM Mono';
  border-right: 1px solid var(--line);
}
.exercise-content {
  padding: 21px 23px 23px;
}
.exercise-heading {
  display: flex;
  justify-content: space-between;
  align-items: start;
  gap: 15px;
}
.concept-tag {
  display: inline-block;
  padding: 5px 8px;
  border-radius: 20px;
  color: var(--green);
  background: var(--mint);
  font: 9px 'DM Mono';
  text-transform: uppercase;
}
.exercise-heading h2 {
  margin: 8px 0 0;
  font: 600 21px 'Space Grotesk';
}
.time-badge {
  margin-left: auto;
  color: #9b7a26;
  background: var(--yellow);
  border-radius: 4px;
  padding: 6px 8px;
  white-space: nowrap;
  font: 9px 'DM Mono';
}
.concept {
  max-width: 750px;
  margin: 10px 0 20px;
  color: #5d6963;
  font-size: 11px;
  line-height: 1.55;
}
.exercise-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
  align-items: stretch;
}
.investigation {
  padding: 16px 17px;
  border-radius: 6px;
  background: #f7f9f6;
}
.investigation h3 {
  margin: 0 0 8px;
  font: 600 12px 'Space Grotesk';
}
.investigation ol {
  margin: 0 0 16px;
  padding-left: 19px;
  color: #58645e;
  font-size: 11px;
  line-height: 1.55;
}
.investigation li + li {
  margin-top: 5px;
}
.measure-row {
  display: flex;
  gap: 9px;
  padding-top: 12px;
  border-top: 1px dashed var(--line);
}
.measure-row span {
  flex: 1;
  color: var(--muted);
  font-size: 9px;
  line-height: 1.4;
}
.measure-row b {
  display: block;
  margin-bottom: 3px;
  color: var(--green);
  font: 9px 'DM Mono';
  text-transform: uppercase;
}
.resource-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 14px;
  margin: 15px 0 0;
}
.resource-links a {
  color: #17636b;
  font-size: 12px;
  font-weight: 600;
}
.api-table-wrap {
  overflow-x: auto;
  margin-top: 18px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: #fff;
}
.api-table {
  width: 100%;
  min-width: 620px;
  border-collapse: collapse;
  font-size: 13px;
  line-height: 1.5;
}
.api-table th,
.api-table td {
  padding: 12px 14px;
  border-bottom: 1px solid var(--line);
  text-align: left;
  vertical-align: top;
}
.api-table th {
  color: #17636b;
  background: #e4f7f9;
  font: 600 12px 'DM Mono';
}
.api-table tr:last-child td {
  border-bottom: 0;
}
.api-table code,
.investigation code,
.context-panel code {
  color: #5f5472;
  font: 12px 'DM Mono';
}
.reference-list {
  margin: 0;
  padding-left: 20px;
  color: #58645e;
  font-size: 14px;
  line-height: 1.6;
}
.reference-list li + li {
  margin-top: 8px;
}
.context-box {
  border: 2px solid #52b9c5;
  border-radius: 6px;
  overflow: hidden;
  box-shadow: 0 0 0 3px #e4f7f9;
  transition: border-color .15s ease, box-shadow .15s ease;
}
.context-box.is-ai-route {
  border-color: #a98bd5;
  box-shadow: 0 0 0 3px #f0eafb;
}
.context-tabs {
  display: flex;
  padding: 4px;
  background: #e4f7f9;
}
.context-box.is-ai-route .context-tabs {
  background: #f0eafb;
}
.context-tab {
  flex: 1;
  padding: 8px 7px;
  border: 0;
  border-radius: 4px;
  color: #89948d;
  background: transparent;
  font: 10px 'DM Mono';
}
.context-tab.active[data-context="nonai"] {
  color: #17636b;
  background: #fff;
  box-shadow: 0 1px 2px #b6dfe3;
}
.context-tab.active[data-context="ai"] {
  color: #6b4d96;
  background: #fff;
  box-shadow: 0 1px 2px #d8c8ee;
}
.context-panel {
  min-height: 164px;
  padding: 16px;
}
.context-panel[data-panel="ai"] {
  background: #fbf9ff;
}
.context-panel strong {
  font-size: 11px;
}
.context-panel h3 {
  margin: 0 0 8px;
  font: 600 12px 'Space Grotesk';
}
.context-panel ol {
  margin: 0 0 16px;
  padding-left: 19px;
  color: #58645e;
  font-size: 11px;
  line-height: 1.55;
}
.context-panel li + li {
  margin-top: 5px;
}
.context-panel p {
  margin: 7px 0 12px;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.5;
}
.context-panel label {
  display: block;
  margin-bottom: 6px;
  color: var(--muted);
  font: 9px 'DM Mono';
  text-transform: uppercase;
}
.context-panel label,
.context-panel textarea {
  display: none;
}
.context-panel textarea {
  width: 100%;
  height: 48px;
  resize: vertical;
  padding: 8px;
  border: 1px solid var(--line);
  border-radius: 4px;
  background: #fff;
  color: var(--ink);
  font-size: 10px;
}
.prompt-snippet {
  padding: 10px;
  border: 1px solid #e1d9f1;
  border-radius: 4px;
  background: var(--lavender);
  color: #5f5472;
  font: 10px/1.45 'DM Mono';
}
.ai-reminder {
  display: block;
  margin-top: 9px;
  color: var(--purple);
  font: 9px 'DM Mono';
}
.validation {
  display: flex;
  justify-content: space-between;
  gap: 28px;
  align-items: center;
  margin-top: 30px;
  padding: 23px 25px;
  border-radius: 8px;
  background: var(--yellow);
}
.validation h2 {
  margin: 6px 0 6px;
  font: 600 22px 'Space Grotesk';
}
.validation p {
  max-width: 630px;
  margin: 0;
  color: #6d674e;
  font-size: 11px;
  line-height: 1.5;
}
.validation-list {
  display: grid;
  gap: 8px;
  color: #786e40;
  white-space: nowrap;
  font: 10px 'DM Mono';
}
footer {
  display: flex;
  justify-content: space-between;
  padding: 30px 3px 0;
  color: #a0aaa4;
  font: 10px 'DM Mono';
}
footer a {
  color: var(--green);
}
@media (max-width:950px) {
  .sidebar {
    width: 200px;
    flex-basis: 200px;
  }
  .main-content {
    padding: 0 30px 32px;
  }
  .orientation-card {
    align-items: flex-start;
  }
  .orientation-key {
    margin-left: 0;
  }
  .model-map {
    display: block;
  }
  .signal-path {
    margin-top: 15px;
  }
  .exercise-grid {
    grid-template-columns: 1fr;
  }
  .context-panel {
    min-height: 0;
  }
  .validation {
    align-items: flex-start;
    flex-direction: column;
  }
  .validation-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
  }
}
@media (max-width:650px) {
  .site-shell {
    display: block;
  }
  .sidebar {
    width: 100%;
    padding: 15px;
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }
  .brand {
    padding-bottom: 15px;
  }
  .course-status, nav, .sidebar-footer {
    display: none;
  }
  .main-content {
    padding: 0 16px 25px;
  }
  .topbar {
    height: 61px;
  }
  .breadcrumb {
    font-size: 10px;
  }
  .breadcrumb b, .breadcrumb span:not(:last-child) {
    display: none;
  }
  .intro {
    padding: 38px 0 31px;
  }
  .intro h1 {
    letter-spacing: -2px;
  }
  .principles {
    flex-wrap: wrap;
    gap: 18px;
  }
  .principles div {
    max-width: 145px;
  }
  .orientation-card {
    display: block;
  }
  .orientation-icon {
    margin-bottom: 12px;
  }
  .orientation-key {
    margin-top: 11px;
  }
  .signal-path {
    gap: 5px;
  }
  .signal-path b {
    display: none;
  }
  .sequence-heading {
    display: block;
  }
  .sequence-heading p {
    margin: 12px 0 0;
  }
  .exercise-card {
    grid-template-columns: 35px 1fr;
  }
  .exercise-content {
    padding: 17px 14px 17px;
  }
  .exercise-heading {
    display: block;
  }
  .time-badge {
    display: inline-block;
    margin-top: 10px;
  }
  .measure-row {
    flex-wrap: wrap;
  }
  .measure-row span {
    min-width: 42%;
  }
  .validation {
    padding: 18px;
  }
  footer {
    display: block;
    line-height: 1.8;
  }
  footer span {
    display: block;
  }
}
.checkpoint-section, .repository-section, .report-section {
  padding-top: 46px;
}
.section-heading {
  display: flex;
  align-items: flex-start;
  gap: 13px;
}
.section-heading h2 {
  margin: 6px 0 0;
  font: 600 24px 'Space Grotesk';
}
.section-lead {
  max-width: 700px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.55;
}
.checkpoint-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 20px;
}
.checkpoint-card {
  display: flex;
  gap: 12px;
  padding: 17px;
  border: 1px solid var(--line);
  border-radius: 7px;
  background: #fff;
}
.checkpoint-number {
  color: var(--orange);
  font: 11px 'DM Mono';
}
.checkpoint-card h3 {
  margin: 0 0 7px;
  font: 600 14px 'Space Grotesk';
}
.checkpoint-card p {
  margin: 0 0 10px;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.5;
}
.checkpoint-card strong {
  color: var(--green);
  font-size: 10px;
}
.checkpoint-pack {
  display: flex;
  gap: 12px;
  align-items: center;
  margin-top: 12px;
  padding: 11px 14px;
  border-left: 3px solid var(--orange);
  background: #fff;
  color: var(--muted);
  font: 10px 'DM Mono';
}
.checkpoint-pack strong {
  color: var(--ink);
}
.repository-section, .report-section {
  margin-top: 42px;
  padding-bottom: 12px;
  border-top: 1px solid var(--line);
}
.repository-grid, .report-grid {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  gap: 25px;
  align-items: start;
  margin-top: 18px;
}
.repo-tree {
  display: inline-block;
  margin-top: 9px;
  padding: 13px 16px;
  border-radius: 6px;
  background: var(--ink);
  color: #dce7e0;
  font: 11px/1.55 'DM Mono';
}
.repo-tree b {
  color: #f0c87e;
}
.repo-guidance {
  display: grid;
  gap: 9px;
}
.repo-guidance div {
  display: grid;
  gap: 4px;
  padding: 11px 13px;
  border: 1px solid var(--line);
  border-radius: 5px;
  background: #fff;
}
.repo-guidance strong {
  color: var(--green);
  font-size: 11px;
}
.repo-guidance span {
  color: var(--muted);
  font-size: 10px;
  line-height: 1.4;
}
.report-headings {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px 17px;
  margin-top: 18px;
  color: var(--orange);
  font: 10px 'DM Mono';
}
.report-headings b {
  color: var(--ink);
  font: 600 10px 'DM Sans';
  margin-left: 6px;
}
.artefact-card {
